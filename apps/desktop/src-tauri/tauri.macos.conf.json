{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zyrite",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 }
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Default"
      },
      {
        "ext": ["txt", "text"],
        "name": "Plain Text",
        "description": "Text document",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Default"
      },
      {
        "ext": ["json", "jsonc", "json5", "jsonl", "ndjson"],
        "name": "JSON",
        "description": "JSON file",
        "role": "Editor",
        "mimeType": "application/json",
        "rank": "Default"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML",
        "description": "YAML file",
        "role": "Editor",
        "mimeType": "application/yaml",
        "rank": "Default"
      },
      {
        "ext": ["toml"],
        "name": "TOML",
        "description": "TOML file",
        "role": "Editor",
        "mimeType": "application/toml",
        "rank": "Default"
      },
      {
        "ext": ["ini", "cfg", "conf", "config", "properties", "env"],
        "name": "Configuration File",
        "description": "Configuration file",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Default"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "CSV",
        "description": "CSV file",
        "role": "Editor",
        "mimeType": "text/csv",
        "rank": "Default"
      },
      {
        "ext": ["xml"],
        "name": "XML",
        "description": "XML file",
        "role": "Editor",
        "mimeType": "application/xml",
        "rank": "Default"
      },
      {
        "ext": ["log", "out"],
        "name": "Log File",
        "description": "Log file",
        "role": "Viewer",
        "mimeType": "text/x-log",
        "rank": "Default"
      },
      {
        "ext": ["html", "htm", "css", "scss", "sass", "less", "js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx", "vue", "svelte", "py", "rb", "go", "rs", "java", "kt", "kts", "swift", "c", "h", "cc", "cpp", "hpp", "cs", "php", "lua", "pl", "r", "dart", "sql", "sh", "bash", "zsh", "fish", "ps1", "bat", "cmd", "diff", "patch", "tex", "bib", "rst", "adoc", "org", "srt", "vtt", "lock", "proto", "graphql", "gql", "prisma", "tf", "hcl", "nix", "xsd", "xsl"],
        "name": "Source Code",
        "description": "Source code",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
