{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyrite",
  "mainBinaryName": "zyrite",
  "identifier": "ai.z-y.zyrite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zyrite",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown editor",
    "longDescription": "Zyrite: an open-source, free Markdown editor built for documents written by AI agents.",
    "copyright": "Copyright 2026 z-y.ai",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Default"
      },
      {
        "ext": ["txt", "text"],
        "name": "Plain Text",
        "description": "Text document",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Default"
      },
      {
        "ext": ["json", "jsonc", "json5", "jsonl", "ndjson"],
        "name": "JSON",
        "description": "JSON file",
        "role": "Editor",
        "mimeType": "application/json",
        "rank": "Default"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML",
        "description": "YAML file",
        "role": "Editor",
        "mimeType": "application/yaml",
        "rank": "Default"
      },
      {
        "ext": ["toml"],
        "name": "TOML",
        "description": "TOML file",
        "role": "Editor",
        "mimeType": "application/toml",
        "rank": "Default"
      },
      {
        "ext": ["ini", "cfg", "conf", "config", "properties", "env"],
        "name": "Configuration File",
        "description": "Configuration file",
        "role": "Editor",
        "mimeType": "text/plain",
        "rank": "Default"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "CSV",
        "description": "CSV file",
        "role": "Editor",
        "mimeType": "text/csv",
        "rank": "Default"
      },
      {
        "ext": ["xml"],
        "name": "XML",
        "description": "XML file",
        "role": "Editor",
        "mimeType": "application/xml",
        "rank": "Default"
      },
      {
        "ext": ["log", "out"],
        "name": "Log File",
        "description": "Log file",
        "role": "Viewer",
        "mimeType": "text/x-log",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
